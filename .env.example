# PostgreSQL Database Credentials (optional; falls back to SQLite if unreachable)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=agentic_db
SQLITE_FALLBACK_PATH=agentic_re_sdlc.db

# Qdrant Vector Store Configuration (uses server if running, otherwise local QDRANT_PATH)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=documents
QDRANT_PATH=qdrant_storage
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite-preview
